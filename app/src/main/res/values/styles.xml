    <!-- ToggleButton styling -->
    <style name="MyToggleButtonStyle" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <!-- Цвет текста -->
        <item name="android:textColor">@color/toggle_button_text</item>
        <!-- Размер текста -->
<!--        <item name="android:textSize">16sp</item>-->
