<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Text.Secondary" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="fontFamily">@font/poppins</item>
        <item name="android:textColor">@color/secondary_gray</item>
        <item name="android:textSize">@dimen/text_small</item>
    </style>

    <style name="Text.Heading" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="fontFamily">@font/poppins</item>
        <item name="android:textColor">@color/primary_white</item>
        <item name="android:textSize">@dimen/text_extra_large</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.Primary" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="fontFamily">@font/poppins</item>
        <item name="android:textColor">@color/light_gray</item>
        <item name="android:textSize">@dimen/text_regular</item>
    </style>

    <style name="Text.Heading.Small" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="fontFamily">@font/poppins</item>
        <item name="android:textColor">@color/primary_white</item>
        <item name="android:textSize">@dimen/text_regular</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.Button" parent="TextAppearance.MaterialComponents.Button">
        <item name="fontFamily">@font/poppins</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.Secondary.Bold" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="fontFamily">@font/poppins</item>
        <item name="android:textColor">@color/primary_white</item>
        <item name="android:textSize">@dimen/text_small</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.Heading.Medium" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="fontFamily">@font/poppins</item>
        <item name="android:textColor">@color/primary_white</item>
        <item name="android:textSize">@dimen/text_huge</item>
    </style>

    <style name="Text.Calendar.Date" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="fontFamily">@font/poppins</item>
        <item name="android:textColor">@color/primary_white</item>
        <item name="android:textSize">@dimen/text_micro</item>
    </style>

    <style name="Text.Calendar.Weekday" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="fontFamily">@font/poppins</item>
        <item name="android:textColor">@color/secondary_gray</item>
        <item name="android:textSize">@dimen/text_small</item>
    </style>
</resources>