    <ImageView
        android:id="@+id/iv_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/regular_margin"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/lbl_empty_entries"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/card_total_budget"
        app:layout_constraintVertical_chainStyle="packed"
        app:srcCompat="@drawable/circle_goal"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/lbl_empty_entries"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:padding="@dimen/regular_margin"
        android:text="@string/no_budgets_set"
        android:textAlignment="center"
        android:textAppearance="@style/Text.Secondary"
        android:textSize="16sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iv_empty"
        tools:visibility="visible" />

