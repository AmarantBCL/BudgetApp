<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/window_black"
    android:paddingTop="@dimen/regular_margin">

    <ImageView
        android:id="@+id/img_icon"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:clickable="true"
        android:focusable="true"
        android:padding="2dp"
        android:src="@drawable/circle_shopping"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:fontFamily="@font/rubik"
        android:maxLines="1"
        android:paddingHorizontal="4dp"
        android:text="Category"
        android:textColor="@color/secondary_gray"
        android:textStyle="normal"
        app:layout_constraintEnd_toEndOf="@id/img_icon"
        app:layout_constraintStart_toStartOf="@id/img_icon"
        app:layout_constraintTop_toBottomOf="@id/img_icon" />

</androidx.constraintlayout.widget.ConstraintLayout>