<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/card_background"
    app:cardCornerRadius="@dimen/card_corner_radius"
    app:cardElevation="@dimen/card_elevation"
    app:cardUseCompatPadding="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/img_color_circle"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_margin="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/shape_color_circle" />

        <TextView
            android:id="@+id/tv_target_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:textAppearance="@style/Text.Primary"
            android:textColor="@color/primary_white"
            app:layout_constraintBottom_toBottomOf="@id/img_color_circle"
            app:layout_constraintEnd_toStartOf="@id/btn_add"
            app:layout_constraintStart_toEndOf="@id/img_color_circle"
            app:layout_constraintTop_toTopOf="@id/img_color_circle"
            tools:text="Emergency Fund" />

        <ImageButton
            android:id="@+id/btn_add"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:background="@drawable/bg_mini_button"
            android:backgroundTint="@color/accent_purple"
            android:scaleType="centerInside"
            android:soundEffectsEnabled="true"
            android:src="@drawable/ic_plus"
            app:layout_constraintBottom_toBottomOf="@id/tv_target_name"
            app:layout_constraintEnd_toStartOf="@id/btn_subtract"
            app:layout_constraintTop_toTopOf="@id/tv_target_name"
            app:tint="@color/primary_white" />

        <ImageButton
            android:id="@+id/btn_subtract"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:background="@drawable/bg_mini_button"
            android:backgroundTint="@color/accent_purple"
            android:scaleType="centerInside"
            android:soundEffectsEnabled="true"
            android:src="@drawable/ic_minus"
            app:layout_constraintBottom_toBottomOf="@id/tv_target_name"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tv_target_name"
            app:tint="@color/primary_white" />

        <TextView
            android:id="@+id/lbl_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            android:text="Progress"
            android:textAppearance="@style/Text.Secondary"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/img_color_circle" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_currency"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginHorizontal="16dp"
            android:enabled="false"
            android:text="USD"
            android:textColor="@color/accent_purple"
            app:chipBackgroundColor="@color/background_dark_purple"
            app:layout_constraintBottom_toBottomOf="@id/lbl_progress"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/lbl_progress" />

        <TextView
            android:id="@+id/tv_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:textAppearance="@style/Text.Heading.Small"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/lbl_progress"
            tools:text="6,500 / 10,000" />

        <TextView
            android:id="@+id/tv_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:textAppearance="@style/Text.Secondary"
            app:layout_constraintBottom_toBottomOf="@id/tv_progress"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tv_progress"
            tools:text="65% complete" />

        <ProgressBar
            android:id="@+id/pb_progress"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="0dp"
            android:layout_height="8dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="4dp"
            android:max="100"
            android:progress="65"
            android:progressDrawable="@drawable/bg_progress_bar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_progress" />

        <ImageView
            android:id="@+id/img_days_left"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/pb_progress"
            app:srcCompat="@drawable/ic_calendar"
            app:tint="@color/secondary_gray" />

        <TextView
            android:id="@+id/tv_days_left"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:includeFontPadding="false"
            android:textAppearance="@style/Text.Secondary"
            app:layout_constraintBottom_toBottomOf="@id/img_days_left"
            app:layout_constraintStart_toEndOf="@id/img_days_left"
            app:layout_constraintTop_toTopOf="@id/img_days_left"
            tools:text="127 days left" />

        <ImageView
            android:id="@+id/img_dollar"
            android:layout_width="16dp"
            android:layout_height="16dp"
            app:layout_constraintBottom_toBottomOf="@id/img_days_left"
            app:layout_constraintEnd_toStartOf="@id/tv_to_go"
            app:layout_constraintTop_toTopOf="@id/img_days_left"
            app:srcCompat="@drawable/ic_dollar"
            app:tint="@color/secondary_gray" />

        <TextView
            android:id="@+id/tv_to_go"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:textAppearance="@style/Text.Secondary"
            app:layout_constraintBottom_toBottomOf="@id/img_days_left"
            app:layout_constraintEnd_toEndOf="@id/pb_progress"
            app:layout_constraintTop_toTopOf="@id/img_days_left"
            tools:text="3,500 to go" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>