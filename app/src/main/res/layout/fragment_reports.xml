    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_income_expenses"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        android:layout_marginTop="0dp"
        app:cardBackgroundColor="@color/card_background"
        app:cardCornerRadius="@dimen/card_corner_radius"
        app:cardElevation="@dimen/card_elevation"
        app:cardUseCompatPadding="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/lbl_income"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/regular_margin"
                android:paddingTop="@dimen/regular_margin"
                android:text="@string/income"
                android:textAlignment="center"
                android:textAppearance="@style/Text.Secondary"
                android:textColor="@color/light_gray"
                android:textSize="14sp"
                app:layout_constraintEnd_toStartOf="@id/divider"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tv_income"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/rubik"
                android:paddingHorizontal="@dimen/regular_margin"
                android:textAppearance="@style/Text.Secondary"
                android:textColor="@color/positive_green"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="@id/lbl_income"
                app:layout_constraintStart_toStartOf="@id/lbl_income"
                app:layout_constraintTop_toBottomOf="@id/lbl_income"
                tools:text="+500.0" />

            <View
                android:id="@+id/divider"
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_marginVertical="8dp"
                android:background="@color/divider_color"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/lbl_expenses"
                app:layout_constraintStart_toEndOf="@id/lbl_income"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/lbl_expenses"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/regular_margin"
                android:paddingTop="@dimen/regular_margin"
                android:text="@string/expenses"
                android:textAlignment="center"
                android:textAppearance="@style/Text.Secondary"
                android:textColor="@color/light_gray"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/divider"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tv_expenses"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/rubik"
                android:paddingHorizontal="@dimen/regular_margin"
                android:paddingBottom="@dimen/small_margin"
                android:textAppearance="@style/Text.Secondary"
                android:textColor="@color/negative_red"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="@id/lbl_expenses"
                app:layout_constraintStart_toStartOf="@id/lbl_expenses"
                app:layout_constraintTop_toBottomOf="@id/lbl_income"
                tools:text="-1529.0" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

    <!--    <ImageView-->
    <!--        android:id="@+id/img_icon"-->
