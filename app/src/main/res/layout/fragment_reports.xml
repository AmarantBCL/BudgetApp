    <!--        app:layout_constraintTop_toTopOf="@id/date_range_report_spinner"-->
    <!--        app:tint="@color/accent_purple" />-->

    <Spinner
        android:id="@+id/spinner_date_range"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginHorizontal="@dimen/large_margin"
        android:pointerIcon="arrow"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/card_income_expenses"
        app:layout_scrollFlags="scroll|enterAlways" />
    <!--    </com.google.android.material.appbar.AppBarLayout>-->

    <ImageView
        android:id="@+id/img_dollar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/regular_margin"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/lbl_empty_entries"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/spinner_date_range"
        app:layout_constraintVertical_chainStyle="packed"
        app:srcCompat="@drawable/circle_dollar"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/lbl_empty_entries"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:padding="@dimen/regular_margin"
        android:text="@string/no_entries_for_this_period"
        android:textAlignment="center"
        android:textAppearance="@style/Text.Secondary"
        android:textSize="16sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/img_dollar"
        tools:visibility="visible" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_reports"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/spinner_date_range" />

</androidx.constraintlayout.widget.ConstraintLayout>