<!--            android:textSize="10sp"-->
<!--            app:layout_constraintStart_toStartOf="@+id/tv_category_name"-->
<!--            app:layout_constraintTop_toBottomOf="@+id/tv_category_name"-->
<!--            tools:text="monthly" />-->

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_period"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginHorizontal="16dp"
            android:enabled="false"
            android:textColor="@color/overdue_text"
            app:chipBackgroundColor="@color/overdue_background"
            app:layout_constraintBottom_toBottomOf="@id/tv_label_progress"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tv_label_progress"
            tools:text="Completed" />

        <ImageButton
            android:id="@+id/btn_delete"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_margin="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_clear"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/light_gray" />

        <ImageButton
            android:id="@+id/btn_edit"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_margin="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_edit"
            app:layout_constraintEnd_toStartOf="@+id/btn_delete"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/light_gray" />

        <TextView
            android:id="@+id/tv_label_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:text="@string/progress"
            android:textAppearance="@style/Text.Secondary"
            android:textColor="@color/light_gray"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/iv_category_icon" />

        <TextView
            android:id="@+id/tv_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:textAppearance="@style/Text.Heading.Small"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_label_progress"
            tools:text="400 / 7,500" />

