<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/calendarFragment"
        android:name="com.amarant.apps.budgetapp.ui.fragments.CalendarFragment"
        android:label="@string/calendar"
        tools:layout="@layout/fragment_calendar">
        <action
            android:id="@+id/action_calendarFragment_to_budgetEntryFragment"
            app:destination="@id/budgetEntryFragment"
            app:popUpTo="@id/calendarFragment" />
        <action
            android:id="@+id/action_calendarFragment_to_pinFragment"
            app:destination="@id/pinFragment"
            app:popUpTo="@id/calendarFragment" />
        <action
            android:id="@+id/action_calendarFragment_to_fragmentAddEntry"
            app:destination="@id/fragmentAddEntry"
            app:enterAnim="@anim/enter_from_right"
            app:exitAnim="@anim/exit_to_left"
            app:popEnterAnim="@anim/enter_from_left"
            app:popExitAnim="@anim/exit_to_right" />
    </fragment>
    <fragment
        android:id="@+id/budgetEntryFragment"
        android:name="com.amarant.apps.budgetapp.ui.fragments.BudgetEntryFragment"
        android:label="Add entry"
        tools:layout="@layout/fragment_budget_entry">
        <argument
            android:name="selectedDate"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
    </fragment>
    <fragment
        android:id="@+id/profileFragment"
        android:name="com.amarant.apps.budgetapp.ui.fragments.ProfileFragment"
        android:label="ProfileFragment"
        tools:layout="@layout/fragment_profile">
        <action
            android:id="@+id/action_profileFragment_to_calendarFragment"
            app:destination="@id/calendarFragment" />
    </fragment>
    <fragment
        android:id="@+id/reportsFragment"
        android:name="com.amarant.apps.budgetapp.ui.fragments.ReportsFragment"
        android:label="@string/spending_reports"
        tools:layout="@layout/fragment_reports" >
        <action
            android:id="@+id/action_reportsFragment_to_fragmentAddEntry"
            app:destination="@id/fragmentAddEntry"
            app:enterAnim="@anim/enter_from_right"
            app:exitAnim="@anim/exit_to_left"
            app:popEnterAnim="@anim/enter_from_left"
            app:popExitAnim="@anim/exit_to_right" />
    </fragment>
    <action
        android:id="@+id/action_global_profileFragment"
        app:destination="@id/profileFragment" />
    <fragment
        android:id="@+id/piggyBankFragment"
        android:name="com.amarant.apps.budgetapp.ui.fragments.PiggyBankFragment"
        android:label="Piggy bank"
        tools:layout="@layout/fragment_piggy_bank" />
    <fragment
        android:id="@+id/pinFragment"
        android:name="com.amarant.apps.budgetapp.ui.fragments.PinFragment"
        android:label="fragment_pin"
        tools:layout="@layout/fragment_pin" />
    <fragment
        android:id="@+id/splashFragment"
        android:name="com.amarant.apps.budgetapp.ui.fragments.SplashFragment"
        android:label="SplashFragment"
        tools:layout="@layout/fragment_splash">
        <action
            android:id="@+id/action_splashFragment_to_calendarFragment"
            app:destination="@id/calendarFragment"
            app:enterAnim="@anim/enter_from_right"
            app:exitAnim="@anim/exit_to_left"
            app:popEnterAnim="@anim/enter_from_left"
            app:popExitAnim="@anim/exit_to_right"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_splashFragment_to_onboardingFragment"
            app:destination="@id/onboardingFragment"
            app:enterAnim="@anim/enter_from_right"
            app:exitAnim="@anim/exit_to_left"
            app:popEnterAnim="@anim/enter_from_left"
            app:popExitAnim="@anim/exit_to_right"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
    </fragment>
    <fragment
        android:id="@+id/onboardingFragment"
        android:name="com.amarant.apps.budgetapp.ui.fragments.OnboardingFragment"
        android:label="OnboardingFragment"
        tools:layout="@layout/fragment_onboarding">
        <action
            android:id="@+id/action_onboardingFragment_to_calendarFragment"
            app:destination="@id/calendarFragment"
            app:enterAnim="@anim/enter_from_right"
            app:exitAnim="@anim/exit_to_left"
            app:popEnterAnim="@anim/enter_from_left"
            app:popExitAnim="@anim/exit_to_right"
            app:popUpTo="@id/onboardingFragment"
            app:popUpToInclusive="true" />
    </fragment>
    <fragment
        android:id="@+id/fragmentAddEntry"
        android:name="com.amarant.apps.budgetapp.ui.fragments.AddEntryFragment"
        android:label="@string/add_entry"
        tools:layout="@layout/fragment_add_entry">
        <argument
            android:name="selectedDate"
            android:defaultValue="0L"
            app:argType="long" />
        <argument
            android:name="budgetEntry"
            app:argType="com.amarant.apps.budgetapp.entities.BudgetUI"
            app:nullable="true" />
    </fragment>
</navigation>